# .env.development (sin .local): se sube a git. Contiene valores comunes de desarrollo,
# no secretos. Si fuera .env.development.local, git lo ignoraría y cada clon tendría
# que crear el fichero a mano.
# Vite solo lo carga con `npm run dev`. `npm run build` usa .env.production.local.
VITE_API_BASE_URL=http://localhost:8080
